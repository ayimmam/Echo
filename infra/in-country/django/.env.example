# Copy outside the web root; generate a private 50+ character secret.
ECHO_ENV=production
ECHO_SECRET_KEY=
ECHO_ALLOWED_HOSTS=research.example.et
ECHO_DB_ENGINE=postgresql
ECHO_DB_NAME=echo
ECHO_DB_USER=echo_app
ECHO_DB_PASSWORD=
ECHO_DB_HOST=localhost
ECHO_DB_PORT=5432
ECHO_DB_SSLMODE=verify-full
ECHO_TRUSTED_PROXY=no
# Set yes ONLY after provider location, backup and withdrawal evidence is reviewed.
ECHO_HOSTING_APPROVED=no
ECHO_RETENTION_APPROVED=no
